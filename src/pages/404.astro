---
import Layout from "../layouts/Layout.astro";
import { homePath, tx } from "../lib/i18n";

export const prerender = false;

// The tree the visitor was in, so a 404 under /en/ does not switch language.
const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "de";
const t = tx(lang);
---

<Layout title={t.notFound} description={t.notFoundBody} lang={lang} noindex>
  <h1 class="shop-title">{t.notFound}</h1>
  <p class="shop-lede">{t.notFoundBody}</p>
  <p class="shop-pager">
    <a class="btn btn-primary" href={homePath(lang)}>{t.backToCatalogue}</a>
  </p>
</Layout>
