---
import Layout from "../layouts/Layout.astro";
import { SW_PAGE_CACHE } from "@tracht-digital-solutions/tds-shared/pwa";
// The service worker's fallback page (src/pages/sw.js.ts). Lists the
// catalogue pages this device kept; the basket and checkout are never cached.
export const prerender = true;
---

<Layout title="Offline" description="Sie sind gerade offline." lang="de" noindex>
  <h1 class="shop-title">Sie sind gerade offline.</h1>
  <p class="shop-lede">Diese Seite ist noch nicht auf Ihrem Gerät. Diese Produktseiten können Sie ohne Verbindung ansehen:</p>
  <ul id="offline-list" class="shop-offline-list" data-cache={SW_PAGE_CACHE} data-lang="de"></ul>
  <p id="offline-none" class="shop-lede" hidden>Noch nichts gespeichert. Produktseiten, die Sie online öffnen, bleiben danach offline lesbar. Bestellen geht nur mit Verbindung.</p>
  <p class="shop-pager"><button type="button" class="btn btn-primary" id="offline-retry">Erneut versuchen</button></p>
</Layout>

<script>
  const list = document.getElementById("offline-list");
  const none = document.getElementById("offline-none");
  document.getElementById("offline-retry")?.addEventListener("click", () => location.reload());
  (async () => {
    if (!list || !("caches" in window)) { if (none) none.hidden = false; return; }
    const cache = await caches.open(list.dataset.cache ?? "tds-pages");
    const en = list.dataset.lang === "en";
    let n = 0;
    for (const req of [...(await cache.keys())].reverse()) {
      const path = new URL(req.url).pathname;
      if (!/\/(produkt|product)\//.test(path) || en !== path.startsWith("/en/")) continue;
      const html = await (await cache.match(req))?.text();
      const title = (html?.match(/<title>([^<]*)<\/title>/)?.[1] ?? path).split(" — ")[0]!.split(" | ")[0]!.trim();
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = path; a.textContent = title; a.className = "link-underline";
      li.append(a); list.append(li); n++;
    }
    if (none) none.hidden = n > 0;
  })();
</script>
