---
import Layout from "../layouts/Layout.astro";
import { homePath, tx } from "../lib/i18n";

export const prerender = false;

const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "de";
const t = tx(lang);

// Its own sentence, not the 404's: "the link is outdated or mistyped" is the
// wrong explanation for a server fault. And "Sie", like every other page.
const title = lang === "de" ? "Etwas ist schiefgelaufen" : "Something went wrong";
const body =
  lang === "de"
    ? "Der Fehler ist protokolliert. Versuchen Sie es in einem Moment noch einmal."
    : "The error has been logged. Please try again in a moment.";
---

<Layout title={title} description={body} lang={lang} noindex>
  <h1 class="shop-title">{title}</h1>
  <p class="shop-lede">{body}</p>
  <p class="shop-pager">
    <a class="btn btn-primary" href={homePath(lang)}>{t.toCatalogue}</a>
  </p>
</Layout>
