---
import CheckoutPage from "../../components/CheckoutPage.astro";
import { productPath } from "../../lib/i18n";
import { resolveSellable } from "../../lib/sellable";

export const prerender = false;

// The lookup and BOTH exits live here. A redirect returned from the component
// would not redirect — it would answer 200 with an empty document.
const slug = String(Astro.params.slug ?? "").trim();
if (!/^[a-z0-9-]{2,120}$/.test(slug)) return Astro.rewrite("/404");

const sellable = await resolveSellable(slug, "de");
// Nothing to sell here. Back to the product page, which can at least explain
// what this is — a generic error would tell the visitor less.
if (!sellable) return Astro.redirect(productPath(slug, "de"), 302);
---

<CheckoutPage lang="de" slug={slug} sellable={sellable} />
