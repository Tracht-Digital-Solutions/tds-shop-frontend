---
import Layout from "../../layouts/Layout.astro";
import { SW_PAGE_CACHE } from "@tracht-digital-solutions/tds-shared/pwa";
// The service worker's fallback page (src/pages/sw.js.ts). Lists the
// catalogue pages this device kept; the basket and checkout are never cached.
export const prerender = true;
---

<Layout title="Offline" description="You are offline." lang="en" noindex>
  <h1 class="shop-title">You are offline.</h1>
  <p class="shop-lede">This page is not on your device yet. You can view these product pages without a connection:</p>
  <ul id="offline-list" class="shop-offline-list" data-cache={SW_PAGE_CACHE}></ul>
  <p id="offline-none" class="shop-lede" hidden>Nothing saved yet. Product pages you open online stay readable offline. Ordering needs a connection.</p>
  <p class="shop-pager"><button type="button" class="btn btn-primary" id="offline-retry">Try again</button></p>
</Layout>

<script>
  import { mountOfflineList } from "@tracht-digital-solutions/tds-shared/pwa";

  // The pages this device kept, newest first (tds-shared helper).
  document.getElementById("offline-retry")?.addEventListener("click", () => location.reload());
  const list = document.getElementById("offline-list");
  if (list) {
    void mountOfflineList(list, {
      english: true,
      match: (path) => /\/(produkt|product)\//.test(path),
      linkClass: "link-underline",
      empty: document.getElementById("offline-none"),
    });
  }
</script>
