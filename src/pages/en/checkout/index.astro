---
import Layout from "../../../layouts/Layout.astro";
import CheckoutForm from "../../../components/CheckoutForm.tsx";
import { tx } from "../../../lib/i18n";

/** The English basket checkout. See `src/pages/kasse/index.astro`. */
export const prerender = false;
---

<Layout title="Checkout" description="Complete your order." lang="en" noindex altUrl="/kasse">
  <h1 class="shop-title">{tx("en").checkout.heading}</h1>
  <CheckoutForm client:load lang="en" />
</Layout>
