---
import type { Lang } from "../lib/i18n";

/**
 * Netto / Brutto for every own price on the page, as one sliding switch. It
 * sits in the header next to the language switch, in the phone's settings
 * sheet and in the price calculator (a modal dialog hides the header). The
 * markup states gross, the legal default for consumers; the choice stays in
 * this browser. Client-side, because the page cache keys on the path alone.
 *
 * A native checkbox with `role="switch"`, labelled by the visible word
 * "Netto" and checked when net prices show; keyboard and form semantics come
 * free. "Brutto" on the other side is a mouse shortcut, hidden from assistive
 * tech, so the name still holds all visible text of the control (WCAG 2.5.3).
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = lang === "en" ? { net: "Net", gross: "Gross" } : { net: "Netto", gross: "Brutto" };
---

<span class="shop-price-switch" data-price-mode-switch>
  <span class="shop-price-switch__side" data-price-set="gross" aria-hidden="true">{ui.gross}</span>
  <label class="shop-price-switch__button">
    <input type="checkbox" class="shop-price-switch__input" role="switch" data-price-switch />
    <span class="shop-price-switch__track" aria-hidden="true"><span class="shop-price-switch__thumb"></span></span>
    <span class="shop-price-switch__side">{ui.net}</span>
  </label>
</span>

<style is:global>
  .shop-price-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .shop-price-switch__side {
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--tds-dur-fast) var(--tds-ease-out);
  }
  .shop-price-switch__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 24px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  /* Visually hidden but focusable; the track shows its state and its focus. */
  .shop-price-switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .shop-price-switch__input:focus-visible + .shop-price-switch__track {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .shop-price-switch__track {
    position: relative;
    display: inline-block;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: var(--tds-radius-pill);
    /* `--color-primary` flips light in dark mode; surface navy would vanish
       into the dark bar. */
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .shop-price-switch__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.25rem - 6px);
    height: calc(1.25rem - 6px);
    border-radius: 50%;
    background: #fff;
    transition: translate var(--tds-dur-base) var(--tds-ease-out);
  }
  /* Gross (off): the left word is the live one. Net (on): the right. */
  .shop-price-switch:has(.shop-price-switch__input:not(:checked)) [data-price-set="gross"],
  .shop-price-switch__input:checked ~ .shop-price-switch__side {
    color: var(--color-ink);
  }
  .shop-price-switch__input:checked + .shop-price-switch__track .shop-price-switch__thumb {
    translate: 1rem 0;
  }
  .shop-price-switch__side:hover {
    color: var(--color-ink);
  }
  /* The settings sheet gives a finger-sized target, like its other controls. */
  .tds-tabpage__section .shop-price-switch {
    font-size: 0.875rem;
    min-height: 2.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .shop-price-switch__thumb,
    .shop-price-switch__side {
      transition: none;
    }
  }
</style>

<script>
  const KEY = "tds-price-mode";
  type Mode = "net" | "gross";

  const read = (): Mode => {
    try {
      return window.localStorage.getItem(KEY) === "net" ? "net" : "gross";
    } catch {
      return "gross";
    }
  };

  const apply = (mode: Mode) => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-price-amount], [data-price-note]")) {
      const text = mode === "net" ? el.dataset.priceNet : el.dataset.priceGross;
      if (text) el.textContent = text;
    }
    for (const input of document.querySelectorAll<HTMLInputElement>("input[data-price-switch]")) {
      input.checked = mode === "net";
    }
    document.documentElement.dataset.priceMode = mode;
    window.dispatchEvent(new CustomEvent("tds:price-mode", { detail: mode }));
  };

  const choose = (mode: Mode) => {
    try {
      window.localStorage.setItem(KEY, mode);
    } catch {
      // Storage blocked: the choice lasts for this page.
    }
    apply(mode);
  };

  document.addEventListener("change", (event) => {
    const input = event.target as HTMLInputElement;
    if (input.matches?.("input[data-price-switch]")) choose(input.checked ? "net" : "gross");
  });
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-price-set='gross']")) choose("gross");
  });

  apply(read());
  // The filter bar clones the full catalogue in once its own script has run.
  window.addEventListener("load", () => apply(read()));
</script>
