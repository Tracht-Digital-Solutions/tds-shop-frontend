---
import { ProductCard } from "@tracht-digital-solutions/tds-shared/components";

import type { CatalogProduct } from "../lib/types";
import type { Lang } from "../lib/i18n";
import { tx } from "../lib/i18n";
import { siteLinks } from "../lib/seo";
import { withAttribution } from "../lib/offers";
import { productImageAttributes } from '../lib/productImages';

interface Props {
  products: CatalogProduct[];
  lang: Lang;
  /** Attribution for the click counter — which slot these cards came from. */
  placement?: string | null;
  /**
   * Wrap each card in a `.shop-filter-item` carrying what the catalogue's
   * filter bar matches on (kind, search text, title, date). The wrapper is
   * `display: contents`, so the grid still lays out the cards themselves.
   */
  filterable?: boolean;
}

const { products, lang, placement = null, filterable = false } = Astro.props;
const t = tx(lang);

const attributed = products.map((product) => withAttribution(product, lang, placement));

/** Own service, partner offer, or both (a product can carry either kind). */
const kindOf = (product: CatalogProduct): string => {
  const kinds = new Set(product.offers.map((o) => o.kind));
  return kinds.size === 2 ? "own affiliate" : [...kinds][0] ?? "";
};
const searchOf = (product: CatalogProduct): string =>
  [product.title, product.teaser, product.categoryLabel ?? product.category, ...(product.tags ?? [])]
    .join(" ")
    .toLowerCase();
---

{
  /* The empty state is where a visitor decides whether to leave. It used to be
     one grey line; it now says what is happening and offers the two places on
     the same property where there IS something to read or use. */
  attributed.length === 0 ? (
    <div class="shop-empty">
      <p class="shop-empty__title">{t.empty.title}</p>
      <p class="shop-empty__body">{t.empty.body}</p>
      <p class="shop-empty__links">
        <a class="link-underline shop-empty__link" href={siteLinks(lang).blog}>{t.empty.journal}</a>
        <a class="link-underline shop-empty__link" href={siteLinks(lang).tools}>{t.empty.tools}</a>
      </p>
    </div>
  ) : (
    <div class="tds-product-grid">
      {attributed.map((product, i) =>
        filterable ? (
          <div
            class="shop-filter-item"
            data-kind={kindOf(products[i])}
            data-search={searchOf(products[i])}
            data-title={products[i].title}
            data-published={products[i].publishedAt ?? ""}
          >
            <ProductCard product={product} lang={lang} variant="card" addToCart image={productImageAttributes(product,lang)} />
          </div>
        ) : (
          <ProductCard product={product} lang={lang} variant="card" addToCart image={productImageAttributes(product,lang)} />
        ),
      )}
    </div>
  )
}
