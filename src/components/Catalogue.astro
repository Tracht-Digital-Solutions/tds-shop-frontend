---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "./ProductGrid.astro";
import { listCategories, listProducts } from "../lib/content-api";
import { categoryPath, homePath, tx, type Lang } from "../lib/i18n";
import { describe } from "../lib/metaDescription";
import { asGraph, collectionPageSchema, itemListSchema, websiteSchema } from "../lib/jsonld";
import { site } from "../lib/seo";

/**
 * The catalogue, shared by the German and English index routes.
 *
 * Both language entry points are thin wrappers over this, exactly as the
 * journal's `[slug].astro` pair wraps one `Article.astro`: the two differ only
 * in the language they pass, and a second copy is a second set of SEO
 * decisions to keep in step.
 */
interface Props {
  lang: Lang;
  category?: string | null;
}

const { lang, category = null } = Astro.props;
const t = tx(lang);

const [page, categories] = await Promise.all([
  listProducts({ lang, limit: 24, category }),
  listCategories(lang),
]);

const heading = category ?? t.catalogue;
const description = describe(
  category
    ? lang === "de"
      ? `Kuratierte Technik aus der Kategorie ${category}: mit eigener Einschätzung statt Herstellertext.`
      : `Curated technology in the ${category} category, with our own assessment rather than vendor copy.`
    : site.description[lang],
  site.description[lang],
);

const path = category ? categoryPath(category, lang) : homePath(lang);

// The category navigation below renders as a WRAPPING ROW of distinct targets
// (`.shop-catnav`), not a middot-separated sentence. Measured at 390px, the
// run of text made each category a 16px-high tap target with a punctuation
// mark sitting between two of them; the flex gap is the separator now.

const jsonLd = asGraph([
  websiteSchema(lang),
  collectionPageSchema(heading, path, lang),
  itemListSchema(page.products, lang),
]);
---

<Layout title={heading} description={description} lang={lang} jsonLd={jsonLd}>
{/*
    The one wash band on the site. `.tds-wash` paints soft brand fields into a
    ::before at z-index -1, so it needs a SECTION to sit in — never the body,
    and never an element whose children have to stay above it by accident.

    One band, not one per section: the journal uses this effect in a single
    file and the landingpage in nineteen, and the whole point of the blend is
    to land between them rather than to pick a side.
  */}
  <section class="shop-intro tds-wash" aria-labelledby="catalogue-heading">
    <h1 class="shop-title" id="catalogue-heading">{heading}</h1>
    {/* Decorative by definition — aria-hidden is required at the call site,
        because a graphic announced to a screen reader is worse than none. */}
    <span class="tds-brandbar tds-brandbar--sm" aria-hidden="true"></span>
    <p class="shop-lede">{site.description[lang]}</p>

    {/* The standing disclosure, above the products rather than under them. */}
    <p class="shop-disclosure">{t.affiliateNotice}</p>

    {
      categories.length > 0 ? (
        <nav class="shop-catnav" aria-label={t.categories}>
          {categories.map(({ category: name, total }) => (
            <a href={categoryPath(name, lang)}>
              {name} <span class="shop-catnav__count">({total})</span>
            </a>
          ))}
        </nav>
      ) : null
    }
  </section>

  <ProductGrid products={page.products} lang={lang} />
</Layout>
