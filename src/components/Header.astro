---
import { AccountMenu, ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { propertyContact, propertyNav } from "@tracht-digital-solutions/tds-shared/nav";

import CartBadge from "./CartBadge.tsx";
import { homePath, tx, type Lang } from "../lib/i18n";

/**
 * The public property bar — the one top bar the journal, the tools site and
 * the shop share: `.tds-sitebar*` and `propertyNav()` from tds-shared.
 *
 * The shop's bar used to be its own: 72rem wide where the journal ran at
 * 120rem, "Katalog · Journal · Tools · Tracht Digital" where the tools site
 * said "Alle Tools · Blog · Startseite", and no account menu or contact CTA.
 * Following a link between the three moved the logo and renamed the links
 * under the cursor. What stays here is what is the shop's own: the wordmark,
 * the language switch to the resolved alternate, and the basket.
 */
interface Props {
  lang: Lang;
  /**
   * The resolved counterpart page, or null. Passed through from the layout and
   * never derived here: the taxonomy segments differ per language, so pasting
   * `/en/` in front of a path 404s on every listing page.
   */
  altUrl?: string | null;
}

const { lang, altUrl = null } = Astro.props;
const t = tx(lang);
const path = Astro.url.pathname;

/** Trailing slashes are ignored by the router (`trailingSlash: "ignore"`), so
 *  "/en" and "/en/" are the same page and only a normalised compare can say
 *  whether this is the shop's home. */
const trimSlash = (v: string): string => (v.length > 1 && v.endsWith("/") ? v.slice(0, -1) : v);
const isHome = trimSlash(path) === trimSlash(homePath(lang));

/**
 * Both halves of the DE|EN switch. The current language points at this page;
 * the other at the resolved alternate when the page has one, and at that
 * language's catalogue otherwise — a switch that 404s is worse than one that
 * lands on the front page.
 */
const langHrefs = (["de", "en"] as const).map((code) => ({
  code,
  href: code === lang ? path : (altUrl ?? homePath(code)),
}));

/** Journal · Tools · Shop · Tracht Digital, with the shop marked current.
 *  Sibling properties open in the SAME tab — none of these carries `target`. */
const nav = propertyNav("shop", lang, homePath(lang));
const contact = propertyContact(lang);
/** The canonical call, the same words on the landingpage and both sibling bars. */
const cta = translations[lang].nav.cta;
---

{/* Fill, blur, sticky position and the warm hairline all come from
    `.brand-header` (tds-shared). Never re-declare them here. */}
<header class="brand-header tds-app-header" id="site-header">
  {/* `.tds-shell` gives the bar the page's own edges — the blog surface's
      120rem, the same on all three properties. */}
  <div class="tds-shell tds-sitebar">
    {/* The mark IS the "TD" of the name, so only "Shop" is set in type and the
        accessible name restates the whole brand — as "TD Shop", because WCAG
        2.5.3 (axe `label-content-name-mismatch`) wants the visible word "Shop"
        as a word of the name, which "TDShop" is not. `.brand-wordmark` is what
        puts `.accent-italic` back upright (primitives.css). */}
    <a
      class="tds-sitebar__brand brand-wordmark"
      href={homePath(lang)}
      aria-label={`TD Shop — ${t.nav.catalogue}`}
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Shop</span>
    </a>
    <span class="tds-sitebar__divider" aria-hidden="true"></span>

    {/* `page` on the catalogue, `true` everywhere else in the shop: the reader
        is inside this property there, just not on its home. */}
    <nav class="tds-sitebar__nav" aria-label={t.nav.label}>
      {nav.map((item) => (
        <a
          class="tds-sitebar__link"
          href={item.href}
          aria-current={item.current ? (isHome ? "page" : "true") : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* Hidden below `lg` by the shared class on the WRAPPER: tds-shared is
        unlayered, so a `display` rule on the controls themselves would lose to
        theirs. The CTA yields below 80rem through `.tds-sitebar__wide`, the
        same on all three bars. */}
    <div class="tds-sitebar__desktop">
      <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
        {langHrefs.map((l) => (
          <a
            href={l.href}
            hreflang={l.code}
            lang={l.code}
            data-locale-link={l.code}
            class={l.code === lang ? "on" : ""}
            aria-current={l.code === lang ? "true" : undefined}
          >
            {l.code.toUpperCase()}
          </a>
        ))}
      </div>
      <ThemeToggle client:idle labelToDark={t.theme.toDark} labelToLight={t.theme.toLight} />
      <div class="tds-sitebar__wide">
        <a href={contact} class="btn btn-primary">{cta}</a>
      </div>
    </div>

    {/* Visible at every width, in the shared order: who you are, then the
        shop's own extra. On a phone navigation lives in the app tab bar
        (AppChrome.astro), which carries the basket as a tab of its own. */}
    <div class="tds-sitebar__actions">
      <AccountMenu client:idle lang={lang} />
      <CartBadge client:idle lang={lang} />

    </div>
  </div>

</header>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { mountAppHeader, mountPreferenceControls } from "@tracht-digital-solutions/tds-shared/app";

  const header = document.getElementById("site-header");
  if (header) {
    // Phone: tucks away while scrolling down; navigation is the tab bar.
    mountAppHeader(header);
    // The DE/EN switch remembers the choice for every Tracht Digital site.
    mountPreferenceControls(header);
  }
</script>
