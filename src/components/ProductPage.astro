---
import { ProductCard } from "@tracht-digital-solutions/tds-shared/components";
import { renderMarkdown } from "@tracht-digital-solutions/tds-shared/markdown";

import Layout from "../layouts/Layout.astro";
import AddToCart from "./AddToCart.tsx";
import ProductGrid from "./ProductGrid.astro";
import { listProducts } from "../lib/content-api";
import { categoryPath, homePath, productCategoryName, productPath, tx, type Lang } from "../lib/i18n";
import { describe } from "../lib/metaDescription";
import { isIndexable } from "../lib/indexing";
import { asGraph, breadcrumbSchema, productSchema, webPageSchema, websiteSchema } from "../lib/jsonld";
import { productAlternate } from "../lib/alternates";
import { withAttribution } from "../lib/offers";
import { canonical, site } from "../lib/seo";
import type { ProductPage as ProductPageData } from "../lib/types";

/**
 * The product is fetched by the PAGE and handed in here, never fetched here.
 *
 * That is not tidiness — `Astro.rewrite()` only produces a response when it is
 * returned from a page. Returning it from a component's frontmatter simply
 * stops that component rendering, and the page answers **200 with an empty
 * document**: fifteen bytes, no error, and the page cache stores it. A missing
 * product would have been served as a blank success page for as long as the
 * entry lived. So the 404 decision belongs where it can actually be made.
 */
interface Props {
  lang: Lang;
  product: ProductPageData;
}

const { lang, product } = Astro.props;
const t = tx(lang);

/**
 * A product without its own written assessment renders and is reachable, but
 * carries `noindex, follow` and is absent from the sitemap.
 *
 * That is the whole answer to the thin-affiliate problem, and it is one
 * function so the two halves cannot drift: `sitemap.ts` filters on the same
 * `isIndexable()`. A URL submitted for indexing whose page says `noindex` is a
 * self-inflicted crawl-budget hole that reports nothing anywhere.
 */
const indexable = isIndexable(product);

/** The category as a reader sees it, in this language. The raw slug used to
 *  reach the meta description and the breadcrumb markup as "netzwerk". */
const categoryName = productCategoryName(product);

const description = describe(
  product.metaDescription ?? product.teaser,
  categoryName,
  site.description[lang],
);

const related = indexable
  ? (await listProducts({ lang, limit: 4, category: product.category })).products.filter(
      (p) => p.slug !== product.slug,
    )
  : [];

/** Attribution for the click counter — see `attributedOfferUrl`. */
const { offers } = withAttribution(product, lang);

const hasAffiliate = offers.some((offer) => offer.kind === "affiliate");

/**
 * Does TDS sell this itself?
 *
 * Only then is a basket button honest. An affiliate product is bought at the
 * merchant, and a basket beside it would promise a checkout this shop cannot
 * complete — the server would refuse the order with "Dieses Angebot gibt es
 * nicht", which reads as a bug rather than as the truth.
 */
const sellsDirectly = offers.some((offer) => offer.kind === "own");

/**
 * The assessment body.
 *
 * Only the markdown format is rendered for now. A blocks document needs the
 * journal's `BlockRenderer`, which is not in this repository yet — and showing
 * a raw JSON blob would be worse than showing nothing, so an unrendered format
 * yields no section at all rather than a broken one.
 */
const body = product.body && product.bodyFormat === "markdown" ? renderMarkdown(product.body) : "";

/**
 * The locale counterpart, confirmed with a second read rather than derived —
 * a product's translation may live under a different slug, so a pasted `/en/`
 * would be a 404, and one dangling alternate invalidates the whole set.
 */
const altUrl = indexable ? await productAlternate(product.slug, lang) : null;

const selfPath = productPath(product.slug, lang);
const breadcrumbId = `${canonical(selfPath)}#breadcrumb`;

const jsonLd = asGraph([
  websiteSchema(lang),
  /* The page, beside the product: who published it and when the assessment
     was last revised. `updatedAt` has been in the payload all along and
     nothing read it. */
  webPageSchema({
    path: selfPath,
    name: product.title,
    lang,
    dateModified: product.updatedAt,
    breadcrumbId,
  }),
  productSchema(product, lang),
  breadcrumbSchema(
    [
      { name: t.nav.catalogue, path: homePath(lang) },
      { name: categoryName, path: categoryPath(product.category, lang) },
      { name: product.title, path: selfPath },
    ],
    breadcrumbId,
  ),
]);

/**
 * "Stand: Oktober 2026" — the month, because an assessment is not revised on a
 * particular day and a precise date on slow content reads as churn. The
 * machine date in `datetime` stays exact and is what `dateModified` repeats.
 */
const revised = product.updatedAt
  ? new Intl.DateTimeFormat(lang === "de" ? "de-DE" : "en-GB", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(product.updatedAt))
  : null;
---

<Layout
  title={product.title}
  description={description}
  lang={lang}
  noindex={!indexable}
  ogImage={product.imageUrl}
  ogType="product"
  altUrl={altUrl}
  jsonLd={jsonLd}
>
  {/* An ordered list with the current page last: a trail is a sequence, and
      the separator is decoration, so it is hidden from assistive tech rather
      than read out as "Punkt" between every step. */}
  <nav class="shop-breadcrumbs" aria-label={t.breadcrumb}>
    <ol>
      <li><a href={homePath(lang)}>{t.nav.catalogue}</a></li>
      <li>
        <span class="shop-breadcrumbs__sep" aria-hidden="true">/</span>
        <a href={categoryPath(product.category, lang)}>{categoryName}</a>
      </li>
      <li aria-current="page">
        <span class="shop-breadcrumbs__sep" aria-hidden="true">/</span>
        {product.title}
      </li>
    </ol>
  </nav>

  {/* Two columns from `lg`: the text on the reading measure, the offers beside
      it. On a phone the offers come straight after the lede, BEFORE the long
      assessment — someone who already knows the product should not have to
      scroll through our opinion to reach the price. Grid areas carry that
      reordering; the source order stays head → offers → assessment. */}
  <div class="shop-product">
    <div class="shop-product__head">
      <h1 class="shop-title">{product.title}</h1>
      <p class="shop-lede">{product.teaser}</p>

      {/* Who assessed this, and when it was last revised. Both are the point
          of the shop: the assessment is ours, not the vendor's, and a reader
          deciding whether to trust a hardware recommendation needs to know
          how old it is. The `<time>` carries the machine date the page's
          `dateModified` repeats. */}
      {revised && (
        <p class="shop-revised">
          {lang === "de" ? "Stand" : "Updated"}: <time datetime={product.updatedAt!}>{revised}</time>
          <span aria-hidden="true"> · </span>
          {lang === "de" ? "Eingeschätzt von " : "Assessed by "}
          <a href={`${site.mainUrl}/#about`} class="link-underline">{site.legalName}</a>
        </p>
      )}

      {hasAffiliate ? <p class="shop-disclosure">{t.affiliateNotice}</p> : null}
    </div>

    {/* The offer list. `ProductCard` carries the advertising label and drops a
        price older than 24 hours by itself — this page decides neither. */}
    <aside class="shop-product__offers" aria-label={t.offers}>
      <ProductCard product={{ ...product, offers }} lang={lang} variant="list" />

      {/* Only for something TDS sells itself. An affiliate product is bought at
          the merchant, and a basket button beside it would promise a checkout
          this shop cannot honour.

          Directly under the card, and the quieter of the two: the card's
          "Kaufen" goes straight to the one-product checkout and stays the
          filled button. Both ways to buy sit in one place — the basket button
          used to stand under the lede, a column away from the price it adds. */}
      {sellsDirectly ? <AddToCart client:idle slug={product.slug} lang={lang} variant="secondary" /> : null}
    </aside>

    {
      /* The written assessment. Rendered through tds-shared's escape-first
         markdown renderer, NOT `set:html` on the raw field: the body is
         authored in a panel and stored verbatim, so it is untrusted as far as
         this page is concerned. `renderMarkdown` escapes everything before it
         transforms anything and allow-lists link schemes.

         `.shop-doc` is not optional. prose.css is not imported on this site and
         Tailwind's preflight strips list markers and heading sizes, so a bare
         container rendered "## Was uns überzeugt" and its bullet list as three
         lines of body text. */
      body ? (
        <section class="shop-product__body" aria-labelledby="assessment-heading">
          <h2 class="shop-section-title" id="assessment-heading">{t.ourAssessment}</h2>
          <div class="shop-doc" set:html={body} />
        </section>
      ) : null
    }
  </div>

  {
    related.length > 0 ? (
      <>
        <h2 class="shop-section-title">{t.relatedCategory}</h2>
        <ProductGrid products={related} lang={lang} />
      </>
    ) : null
  }

  <p class="shop-pager">
    <a class="btn btn-ghost" href={categoryPath(product.category, lang)}>
      {t.backToCatalogue}
    </a>
  </p>

  <link rel="prefetch" href={canonical(homePath(lang))} />
</Layout>
