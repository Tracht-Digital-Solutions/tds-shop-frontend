---
import Layout from "../layouts/Layout.astro";
import CheckoutForm from "./CheckoutForm.tsx";
import { productPath, type Lang } from "../lib/i18n";
import { describe } from "../lib/metaDescription";
import type { Sellable } from "../lib/sellable";

/**
 * The order page.
 *
 * The lookup and the redirect live in the PAGE, not here — `Astro.redirect()`
 * from a component's frontmatter does not produce a response, it just stops
 * this component rendering, and the page then answers 200 with an empty
 * document. This repository has shipped that once already (see
 * `ProductPage.astro`); a checkout doing it would greet a would-be buyer with
 * a blank success page.
 *
 * Never cached — `src/lib/noCache.ts`, the middleware and `.htaccess` all
 * exclude `/kasse`. A cached checkout would show the next visitor the previous
 * one's order, and it would look like a working page.
 *
 * The mandatory details (§ 312j Abs. 3 BGB) are fetched by the form rather
 * than rendered here, and the order button does not exist until they arrive —
 * see the note in `CheckoutForm`. Server-rendering them would buy nothing:
 * the form is a React island, so without a script there is no working button
 * either way, and a second place computing a total is a second place for it to
 * disagree with what is charged.
 *
 * The server-side lookup stays, though. It is what decides whether this page
 * exists at all — an unsellable slug redirects to the product page from the
 * route above, which a client-side check could not do.
 */
interface Props {
  lang: Lang;
  slug: string;
  sellable: Sellable;
}

const { lang, slug, sellable } = Astro.props;
const { product } = sellable;
---

<Layout
  title={product.title}
  description={describe(product.teaser, product.category)}
  lang={lang}
  noindex
>
  <nav class="shop-breadcrumbs">
    <a href={productPath(slug, lang)}>{product.title}</a>
  </nav>

  <CheckoutForm client:load slug={slug} lang={lang} />
</Layout>
