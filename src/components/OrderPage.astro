---
import Layout from "../layouts/Layout.astro";
import { formatPrice, getOrder } from "../lib/checkout";
import { homePath, tx, type Lang } from "../lib/i18n";

/**
 * The customer's own order, after payment.
 *
 * Also Stripe's `success_url`, which means it is the first page somebody sees
 * after paying — and the webhook that marks the order paid may not have
 * arrived yet. So a `pending` order is rendered as "we have your payment,
 * confirmation follows", never as a failure. Telling a paying customer their
 * order does not exist because of a race is the worst thing this page could do.
 *
 * The token in the URL is the whole authorisation: a guest has no account. It
 * is 32 hex characters and the API rejects anything else.
 *
 * Never cached — it is one person's order.
 */
interface Props {
  lang: Lang;
  token: string;
}

const { lang, token } = Astro.props;
const t = tx(lang);
const order = await getOrder(token);

const copy = lang === "de"
  ? {
      title: "Ihre Bestellung",
      paid: "Bezahlt. Vielen Dank!",
      pending: "Zahlung eingegangen — die Bestätigung folgt in wenigen Augenblicken.",
      refunded: "Diese Bestellung wurde erstattet.",
      failed: "Die Zahlung ist nicht zustande gekommen.",
      next: {
        digital: "Wir melden uns per E-Mail und beginnen mit der Leistung.",
        goods: "Wir melden uns per E-Mail und versenden die Ware.",
        mixed: "Wir melden uns per E-Mail, beginnen mit der Leistung und versenden die Ware.",
      },
      shipping: "Versand",
      shippingFree: "kostenlos",
      address: "Lieferanschrift",
      notFound: "Diese Bestellung konnten wir nicht finden.",
      notFoundBody: "Bitte prüfen Sie den Link aus Ihrer Bestätigungs-E-Mail.",
      number: "Bestellnummer",
      net: "Netto",
      vat: "USt",
      total: "Gesamt",
      confirmed: "Bestätigt",
    }
  : {
      title: "Your order",
      paid: "Paid. Thank you!",
      pending: "Payment received — confirmation follows in a moment.",
      refunded: "This order has been refunded.",
      failed: "The payment did not go through.",
      next: {
        digital: "We will be in touch by email and begin the work.",
        goods: "We will be in touch by email and ship your goods.",
        mixed: "We will be in touch by email, begin the work and ship your goods.",
      },
      shipping: "Delivery",
      shippingFree: "free",
      address: "Delivery address",
      notFound: "We could not find this order.",
      notFoundBody: "Please check the link from your confirmation email.",
      number: "Order number",
      net: "Net",
      vat: "VAT",
      total: "Total",
      confirmed: "Confirmed",
    };

const statusLine = order === null
  ? null
  : order.status === "paid"
    ? copy.paid
    : order.status === "refunded"
      ? copy.refunded
      : order.status === "failed"
        ? copy.failed
        : copy.pending;

/**
 * What happens next depends on what was bought. "We begin the work" was the
 * only sentence, so somebody who ordered a router was told a service starts.
 */
const shipped = order?.items.filter((item) => Boolean(item.requires_shipping)).length ?? 0;
const regime = !order || shipped === 0 ? "digital" : shipped === order.items.length ? "goods" : "mixed";

/** The delivery address, when one was collected. Shown so a typo can be caught. */
const addressLines = order?.ship_line1
  ? [
      order.ship_name,
      order.ship_line1,
      order.ship_line2,
      [order.ship_postcode, order.ship_city].filter(Boolean).join(" "),
      order.ship_country,
    ].filter((line): line is string => Boolean(line && line.trim()))
  : [];
---

<Layout title={copy.title} description={copy.title} lang={lang} noindex>
  {
    order === null ? (
      <>
        <h1 class="shop-title">{copy.notFound}</h1>
        <p class="shop-lede">{copy.notFoundBody}</p>
        <p class="shop-pager"><a class="btn btn-primary" href={homePath(lang)}>{t.backToCatalogue}</a></p>
      </>
    ) : (
      <>
        <h1 class="shop-title">{copy.title}</h1>
        <p class="shop-lede">{statusLine}</p>

        <dl class="order-summary">
          <div><dt>{copy.number}</dt><dd>{order.order_no}</dd></div>
          {order.items.map((item) => (
            <div>
              <dt>{(item.quantity ?? 1) > 1 ? `${item.quantity} × ` : ""}{item.title}</dt>
              <dd>{formatPrice(item.gross_cents, order.currency, lang)}</dd>
            </div>
          ))}
          {regime !== "digital" && order.shipping_gross_cents !== undefined ? (
            <div>
              <dt>{copy.shipping}</dt>
              <dd>
                {order.shipping_gross_cents === 0
                  ? copy.shippingFree
                  : formatPrice(order.shipping_gross_cents, order.currency, lang)}
              </dd>
            </div>
          ) : null}
          <div><dt>{copy.net}</dt><dd>{formatPrice(order.net_cents, order.currency, lang)}</dd></div>
          <div><dt>{copy.vat}</dt><dd>{formatPrice(order.tax_cents, order.currency, lang)}</dd></div>
          <div class="order-summary__total">
            <dt>{copy.total}</dt><dd>{formatPrice(order.gross_cents, order.currency, lang)}</dd>
          </div>
        </dl>

        {addressLines.length > 0 ? (
          <section class="order-summary__address" aria-labelledby="order-address">
            <h2 id="order-address">{copy.address}</h2>
            <address>
              {addressLines.map((line, i) => (
                <>
                  {i > 0 ? <br /> : null}
                  {line}
                </>
              ))}
            </address>
          </section>
        ) : null}

        {order.status === "paid" ? <p>{copy.next[regime]}</p> : null}

        {/* Read back the exact sentence they agreed to — § 356 Abs. 4 BGB
            makes that wording the thing that matters, and the customer is
            entitled to see it on a durable record of their order. */}
        {order.withdrawal_consent_text ? (
          <p class="order-summary__consent">
            <strong>{copy.confirmed}:</strong> {order.withdrawal_consent_text}
          </p>
        ) : null}

        <p class="shop-pager"><a class="btn btn-ghost" href={homePath(lang)}>{t.backToCatalogue}</a></p>
      </>
    )
  }
</Layout>
