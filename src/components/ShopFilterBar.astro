---
import { tx, type Lang } from "../lib/i18n";

/**
 * The catalogue's filter panel — tds-shared's `.tds-filterbar__panel`, wired
 * by `mountFilterBar()`. Closed by default; opened by `ShopFilterToggle`,
 * which then steps aside so the panel takes the whole filter row. The close
 * button (or Escape) brings the toggle back.
 *
 * Everything happens in the browser over cards already in the page: the page
 * cache keys on the path alone, so `?art=…` could never change what is
 * served. Since 2026-10-19 categories and tags filter here too, the way the
 * Ratgeber's do — without a page load. On the front page the category chips
 * in the hero drive the same group (they stay links for crawlers, a new tab
 * and a reader without JavaScript); on a category page only the tags show.
 *
 * On the grouped front page the shelves show only four cards each, so the
 * full catalogue comes along in a `<template>` (inert, not rendered, not read
 * as content) and replaces the shelves while a filter is set.
 */
interface Props {
  lang: Lang;
  /** The categories to choose between — only on the front page. */
  categories?: { slug: string; name: string }[];
  /** The most common tags on this page, most common first. */
  tags?: string[];
}

const { lang, categories = [], tags = [] } = Astro.props;
const f = tx(lang).filter;
const kinds = ["all", "own", "affiliate"] as const;
const sorts = ["default", "new", "az", "priceUp", "priceDown"] as const;
---

{/* The panel; its toggle (ShopFilterToggle) stands before it in the filter
    row and finds it through `aria-controls`. */}
<div
  class="tds-filterbar__panel"
  id="catalogue-filter"
  data-shop-filter
  data-lang={lang}
  data-shown-one={f.shown(1)}
  data-shown-many={f.shown(2).replace("2", "{n}")}
  data-none={f.none}
  hidden
>
    <input
      type="search"
      class="field-boxed tds-filterbar__search"
      data-filter-search
      placeholder={f.search}
      aria-label={f.search}
      autocomplete="off"
    />
    <fieldset class="tds-filterbar__group">
      <legend class="tds-filterbar__legend">{f.kind}</legend>
      <div class="tds-toolbar">
        {kinds.map((k) => (
          <button type="button" class="chip" data-filter-group="kind" data-value={k} aria-pressed={k === "all" ? "true" : "false"}>
            {f.kinds[k]}
          </button>
        ))}
      </div>
    </fieldset>
    {categories.length > 1 && (
      <fieldset class="tds-filterbar__group">
        <legend class="tds-filterbar__legend">{f.category}</legend>
        <div class="tds-toolbar">
          <button type="button" class="chip" data-filter-group="category" data-value="all" aria-pressed="true">{f.all}</button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter-group="category" data-value={c.slug} aria-pressed="false">
              {c.name}
            </button>
          ))}
        </div>
      </fieldset>
    )}
    {tags.length > 1 && (
      <fieldset class="tds-filterbar__group">
        <legend class="tds-filterbar__legend">{f.tags}</legend>
        <div class="tds-toolbar">
          <button type="button" class="chip" data-filter-group="tag" data-value="all" aria-pressed="true">{f.all}</button>
          {tags.map((tag) => (
            <button type="button" class="chip" data-filter-group="tag" data-value={tag.toLowerCase()} aria-pressed="false">
              #{tag}
            </button>
          ))}
        </div>
      </fieldset>
    )}
    <fieldset class="tds-filterbar__group">
      <legend class="tds-filterbar__legend">{f.sort}</legend>
      <div class="tds-toolbar">
        {sorts.map((k) => (
          <button type="button" class="chip" data-filter-group="sort" data-value={k} aria-pressed={k === "default" ? "true" : "false"}>
            {f.sorts[k]}
          </button>
        ))}
      </div>
    </fieldset>
    <button type="button" class="tds-filterbar__reset" data-filter-reset>{f.reset}</button>
    <button type="button" class="tds-filterbar__close" data-filter-close aria-label={f.close} title={f.close}></button>
</div>

<script>
  import { matchesAllWords, mountFilterBar } from "@tracht-digital-solutions/tds-shared/filter";

  const root = document.querySelector<HTMLElement>("[data-shop-filter]");
  if (root) {
    const lang = root.dataset.lang === "en" ? "en" : "de";
    // Copy from data attributes: the i18n module stays on the server.
    const { shownOne = "", shownMany = "", none = "" } = root.dataset;
    const shown = (n: number) => (n === 1 ? shownOne : shownMany.replace("{n}", String(n)));
    const status = document.querySelector<HTMLElement>("[data-filter-status]");
    const count = document.querySelector<HTMLElement>("[data-filter-count]");
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]");

    // Grouped front page: the full catalogue waits in a template and stands
    // in for the shelves while a filter is set.
    const template = document.querySelector<HTMLTemplateElement>("template[data-filter-all]");
    const results = document.querySelector<HTMLElement>("[data-filter-results]");
    const shelves = Array.from(document.querySelectorAll<HTMLElement>("[data-filter-shelf]"));
    if (template && results) results.append(template.content.cloneNode(true));
    const scope: ParentNode = template && results ? results : document;
    const items = Array.from(scope.querySelectorAll<HTMLElement>(".shop-filter-item"));

    /** Products without a showable price go last in both directions. */
    const price = (item: HTMLElement): number | null =>
      item.dataset.price ? Number(item.dataset.price) : null;
    const byPrice = (a: HTMLElement, b: HTMLElement, dir: 1 | -1): number => {
      const pa = price(a);
      const pb = price(b);
      if (pa === null || pb === null) return pa === pb ? 0 : pa === null ? 1 : -1;
      return (pa - pb) * dir;
    };

    // The hero's category chips are links; on the front page they set the
    // category group instead of loading the category page.
    const panelChip = (value: string) =>
      root.querySelector<HTMLButtonElement>(`button[data-filter-group="category"][data-value="${CSS.escape(value)}"]`);
    const heroChips = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-filter-category]"));
    for (const link of heroChips) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const chip = panelChip(link.dataset.filterCategory ?? "");
        if (!chip) return;
        event.preventDefault();
        chip.click();
        document.querySelector(".shop-filterrow")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    mountFilterBar(root, {
      items,
      match: (item, s) =>
        (s.groups.kind === undefined || s.groups.kind === "all" || (item.dataset.kind ?? "").split(" ").includes(s.groups.kind)) &&
        (s.groups.category === undefined || s.groups.category === "all" || item.dataset.category === s.groups.category) &&
        (s.groups.tag === undefined || s.groups.tag === "all" || (item.dataset.tags ?? "").split("|").includes(s.groups.tag)) &&
        matchesAllWords(item.dataset.search ?? "", s.query),
      compare: (a, b, s) => {
        if (s.groups.sort === "new") return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
        if (s.groups.sort === "az") return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", lang);
        if (s.groups.sort === "priceUp") return byPrice(a, b, 1);
        if (s.groups.sort === "priceDown") return byPrice(a, b, -1);
        return 0;
      },
      onChange: (visible, s) => {
        const category = s.groups.category ?? "all";
        for (const link of heroChips) {
          const on = (link.dataset.filterCategory ?? "") === category;
          if (on) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
        const active =
          s.query !== "" ||
          Object.entries(s.groups).some(([group, value]) => value !== (group === "sort" ? "default" : "all"));
        if (results) results.hidden = !active;
        for (const shelf of shelves) shelf.hidden = active;
        if (status) status.textContent = active ? shown(visible) : "";
        if (count) count.textContent = shown(active ? visible : Number(count.dataset.total ?? visible));
        if (empty) empty.textContent = active && visible === 0 ? none : "";
      },
    });
  }
</script>
