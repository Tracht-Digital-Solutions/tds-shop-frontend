---
import { serializeJsonLd } from "@tracht-digital-solutions/tds-shared/site";
// The two font files the first paint needs, imported for their hashed URLs so
// they can be preloaded (same pattern as the landingpage). Without it the body
// face and the 800-weight display face arrived after first paint and swapped
// in — Lighthouse measured that as the page's whole layout shift (CLS 0.2).
import bodyFont from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import displayFont from "@fontsource/lato/files/lato-latin-900-normal.woff2?url";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource-variable/plus-jakarta-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { API_BASE_META } from "@tracht-digital-solutions/tds-shared/api";
import { ConsentBanner } from "@tracht-digital-solutions/tds-shared/consent";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import {
  pageDirectionScript,
  pageTransitionOptIn,
  speculationRules,
  themeBootstrapScript,
} from "@tracht-digital-solutions/tds-shared/astro";
import AppChrome from "../components/AppChrome.astro";

import "../styles/global.css";
import { apiBase } from "../lib/connection";
import { canonical, pageTitle, site } from "../lib/seo";
import { legalPath, type Lang } from "../lib/i18n";
import { isExcludedPath } from "../lib/indexing";

interface Props {
  /** The subject of the page. `pageTitle()` composes the brand around it. */
  title: string;
  description: string;
  lang?: Lang;
  /**
   * The counterpart page in the other language.
   *
   * `undefined` means "look it up" — but there is nothing to look up here, so
   * it renders NO hreflang. `null` suppresses it explicitly. A string is a
   * resolved alternate.
   *
   * Never derived by pasting `/en/` in front of the current path: the taxonomy
   * segments differ per language (`kategorie` ↔ `category`), so the derived
   * URL would be a 404 on every listing page, and hreflang pointing at a 404
   * is worse than no hreflang.
   */
  altUrl?: string | null;
  /** Force `noindex` regardless of path (a product without its own text). */
  noindex?: boolean;
  ogImage?: string | null;
  /**
   * `og:type`. `product` on a product page, `website` everywhere else.
   *
   * It was hard-coded to `website` on every page, including the ones whose
   * main entity is a product — the same pages whose JSON-LD already said
   * `Product`. The two now agree.
   */
  ogType?: "website" | "product";
  /** JSON-LD graph, already wrapped by `asGraph`. */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  lang = "de",
  altUrl = null,
  noindex = false,
  ogImage = null,
  ogType = "website",
  jsonLd = null,
} = Astro.props;

const path = Astro.url.pathname;
const url = canonical(path);

/**
 * hreflang must be a fully qualified URL.
 *
 * The four cart and checkout pages passed site-relative paths ("/en/cart"), so
 * the rendered alternate was relative too. A browser resolves that against the
 * document, but Google's hreflang spec wants an absolute URL and treats a
 * relative one as malformed — the whole set then counts as broken rather than
 * as three good links and one iffy one.
 *
 * Normalising here rather than in four callers means no page can get this
 * wrong again, including pages that do not exist yet.
 */
const alternate = altUrl && altUrl.startsWith("/") ? canonical(altUrl) : altUrl;
const robots = noindex || isExcludedPath(path) ? "noindex, follow" : "index, follow";
const image = ogImage ?? `${site.url}/og-default.png`;
---

<!--
  data-surface selects the geometry layer from tds-shared's design library.
  This site renders the JOURNAL surface — the same file blog.tracht-digital.de
  and tools.tracht-digital.de render — so the three read as one property rather
  than three that resemble each other. Do not author radii locally.
-->
<html lang={lang} data-surface="blog" data-flat class="tds-app">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* `crossorigin` is required: fonts load in CORS mode, and a preload
        without it warms a second request that nothing uses. */}
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <!-- The cross-page transition switch, as early as it can be: Chrome decides the
         incoming page's opt-in at its first render, and the stylesheet linked at the
         end of this head often arrives later (tds-shared pageTransitionOptIn). -->
    <style is:inline set:html={pageTransitionOptIn} />
    {/* Tags each page transition forward/back, so a phone slides like an app. */}
    <script is:inline set:html={pageDirectionScript} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a14" media="(prefers-color-scheme: dark)" />
    {/* Installable app (tds-shared/pwa). */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="TD Shop" />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={robots} />

    {
      alternate ? (
        <>
          {/* Bare language codes in the MARKUP, matching the marketing site
              and the journal; the sitemap's `xhtml:link` carries the full
              `de-DE`/`en-GB` form. Both are valid, and the four properties
              agreeing is what makes one shared audit possible. */}
          <link
            rel="alternate"
            hreflang={lang === "de" ? "en" : "de"}
            href={alternate}
          />
          <link rel="alternate" hreflang={lang} href={url} />
          <link rel="alternate" hreflang="x-default" href={lang === "de" ? url : alternate} />
        </>
      ) : null
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "de_DE"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "de_DE" : "en_GB"} />
    {/* `twitter:card` alone was the whole Twitter block, so a share fell back
        to whatever the scraper could guess. The three it actually reads cost
        three lines. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle(title)} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="author" content={site.legalName} />

    {/* The brand mark shared by every TDS property — byte-identical to the
        landingpage's, the journal's and the tools site's. This site links back
        to all three and is indexable, so a different tab icon would read as a
        different service. `sizes="any"` stops Chrome asking for a /favicon.ico
        that does not exist. Until now the file itself was missing: the tag was
        here, `public/favicon.png` was not, and a 404 icon looks exactly like a
        site that never declared one. */}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

    {/* Where the islands send their requests.
        Rendered here because `src/lib/connection.ts` is SERVER-ONLY — it reads
        `process.env` and the pairing state at module scope, so an island that
        imported it would fail to hydrate with "process is not defined" and then
        sit there looking finished. tds-shared's browser-safe `apiBase()` reads
        this tag instead, which also means runtime pairing through
        `/tds/connect` reaches the browser without a second request. */}
    <meta name={API_BASE_META} content={apiBase()} />

    {/* Raw, never wrapped in {`…`} — a template body leaks the literal braces
        into dist/ and the script never runs. */}
    <script is:inline set:html={themeBootstrapScript} />

    {
      jsonLd ? (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      ) : null
    }
    {/* Near-instant navigation — never for the basket, checkout, orders or
        the outbound offer redirects, which must only load on a real tap. */}
    <script is:inline type="speculationrules" set:html={speculationRules(["/warenkorb", "/kasse", "/bestellung", "/go/", "/en/cart", "/en/checkout", "/en/order"])} />
  </head>

  <body>
    {/*
      First focusable element on the page, and therefore NOT an island: an
      island mounted `client:idle` hydrates after the first Tab has already
      happened. Two lines of markup and a shared string instead.

      The target carries `tabindex="-1"` — without it the browser scrolls but
      does not MOVE focus, so the next Tab continues from the skip link and the
      whole header is still in the way. That is the failure mode that makes a
      skip link look implemented and not be.
    */}
    <a class="tds-skip-link" href="#main">{translations[lang].a11y.skipToContent}</a>

    {/* The journal's chrome — see Header.astro and Footer.astro. The language
        switch needs the resolved alternate, never a derived one. */}
    <Header lang={lang} altUrl={altUrl} />

    <main class="tds-shell shop-main" id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <AppChrome lang={lang} altUrl={altUrl} />

    <script>
      import { startAccountPrefsSync } from "@tracht-digital-solutions/tds-shared/prefs";
      import { registerServiceWorker } from "@tracht-digital-solutions/tds-shared/app";
      // Signed in? Theme and language follow the account to other devices.
      void startAccountPrefsSync();
      // Installable; catalogue pages stay readable offline (src/pages/sw.js.ts).
      registerServiceWorker();
    </script>

    {/*
      No `categories` — this shop sets nothing beyond what it cannot work
      without: the theme, the language, the basket and the consent record
      itself, all covered by § 25 Abs. 2 Nr. 2 TDDDG. So the banner STATES
      that rather than asking a question with no content. Add a category here
      the day something optional actually ships, and the same component turns
      into a real gate.

      `privacyUrl` points at THIS site's policy. It used to fall back to the
      marketing domain, which sent a shop visitor to a document that does not
      describe the shop's own processing.
    */}
    <ConsentBanner
      client:idle
      lang={lang}
      privacyUrl={legalPath("datenschutz", lang)}
      imprintUrl={legalPath("impressum", lang)}
    />
  </body>
</html>
