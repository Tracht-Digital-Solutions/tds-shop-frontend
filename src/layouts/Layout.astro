---
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource-variable/plus-jakarta-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";

import CartBadge from "../components/CartBadge.tsx";
import { ConsentBanner, ConsentLink } from "@tracht-digital-solutions/tds-shared/consent";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import { themeBootstrapScript } from "@tracht-digital-solutions/tds-shared/astro";

import "../styles/global.css";
import { canonical, pageTitle, site } from "../lib/seo";
import { homePath, tx, type Lang } from "../lib/i18n";
import { isExcludedPath } from "../lib/indexing";
import { LEGAL_KEYS, LEGAL_TITLES, type LegalSlug } from "../lib/legal";

interface Props {
  /** The subject of the page. `pageTitle()` composes the brand around it. */
  title: string;
  description: string;
  lang?: Lang;
  /**
   * The counterpart page in the other language.
   *
   * `undefined` means "look it up" — but there is nothing to look up here, so
   * it renders NO hreflang. `null` suppresses it explicitly. A string is a
   * resolved alternate.
   *
   * Never derived by pasting `/en/` in front of the current path: the taxonomy
   * segments differ per language (`kategorie` ↔ `category`), so the derived
   * URL would be a 404 on every listing page, and hreflang pointing at a 404
   * is worse than no hreflang.
   */
  altUrl?: string | null;
  /** Force `noindex` regardless of path (a product without its own text). */
  noindex?: boolean;
  ogImage?: string | null;
  /** JSON-LD graph, already wrapped by `asGraph`. */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  lang = "de",
  altUrl = null,
  noindex = false,
  ogImage = null,
  jsonLd = null,
} = Astro.props;

const t = tx(lang);
const path = Astro.url.pathname;
const url = canonical(path);
const robots = noindex || isExcludedPath(path) ? "noindex, follow" : "index, follow";
const image = ogImage ?? `${site.url}/og-default.png`;
/** Trailing slashes are ignored by the router (`trailingSlash: "ignore"`), so
 *  "/en" and "/en/" are the same page and only a normalised compare can say
 *  which nav entry is current. */
const trimSlash = (v: string): string => (v.length > 1 && v.endsWith("/") ? v.slice(0, -1) : v);
const isHome = trimSlash(path) === trimSlash(homePath(lang));

const legalBase = lang === "en" ? "/en/legal" : "/rechtliches";
/**
 * Every document the registry knows, derived rather than restated.
 *
 * This used to be a hand-written list, and a hand-written list is how a new
 * legal page ends up published, routed, indexed and linked from nowhere —
 * which is the same as not having it. Adding a key to LEGAL_KEYS now adds the
 * footer link with it.
 */
const legalLinks = (Object.keys(LEGAL_KEYS) as LegalSlug[]).map(
  (slug) => ({ href: `${legalBase}/${slug}`, label: LEGAL_TITLES[lang][slug] }),
);
---

<!--
  data-surface selects the geometry layer from tds-shared's design library.
  This site renders the JOURNAL surface — the same file blog.tracht-digital.de
  and tools.tracht-digital.de render — so the three read as one property rather
  than three that resemble each other. Do not author radii locally.
-->
<html lang={lang} data-surface="blog" data-flat>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title, lang)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={robots} />

    {
      altUrl ? (
        <>
          <link
            rel="alternate"
            hreflang={lang === "de" ? "en" : "de"}
            href={altUrl}
          />
          <link rel="alternate" hreflang={lang} href={url} />
          <link rel="alternate" hreflang="x-default" href={lang === "de" ? url : altUrl} />
        </>
      ) : null
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle(title, lang)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "de_DE"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" />

    {/* Raw, never wrapped in {`…`} — a template body leaks the literal braces
        into dist/ and the script never runs. */}
    <script is:inline set:html={themeBootstrapScript} />

    {
      jsonLd ? (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      ) : null
    }
  </head>

  <body>
    {/*
      First focusable element on the page, and therefore NOT an island: an
      island mounted `client:idle` hydrates after the first Tab has already
      happened. Two lines of markup and a shared string instead.

      The target carries `tabindex="-1"` — without it the browser scrolls but
      does not MOVE focus, so the next Tab continues from the skip link and the
      whole header is still in the way. That is the failure mode that makes a
      skip link look implemented and not be.
    */}
    <a class="tds-skip-link" href="#main">{translations[lang].a11y.skipToContent}</a>

    <header class="shop-header">
      <div class="shop-shell shop-header__inner">
        <a class="shop-header__brand" href={homePath(lang)}>{t.brand}</a>
        <nav class="shop-header__nav" aria-label={t.nav.categories}>
          <a href={homePath(lang)} aria-current={isHome ? "page" : undefined}>{t.nav.home}</a>
          {/* Renders nothing while the basket is empty — a permanent "0" is a
              control that does nothing on almost every page of a catalogue.
              client:idle, not client:load: the header is not why anyone came. */}
          <CartBadge client:idle lang={lang} />
          <a href={lang === "en" ? "/" : "/en/"} hreflang={lang === "en" ? "de" : "en"}>
            {lang === "en" ? "Deutsch" : "English"}
          </a>
        </nav>
      </div>
    </header>

    <main class="shop-shell shop-main" id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="shop-footer">
      <div class="shop-shell">
        <p>{t.tagline}</p>
        {/* Every one of these has to be reachable from every page: § 5 DDG for
            the Impressum, § 312i BGB for the terms and the withdrawal policy —
            a consumer must be able to read them BEFORE ordering, not only
            somewhere in the checkout. */}
        {/* A wrapping row, not a middot-separated sentence: six links read as
            one run of text that way, and on a phone the separators sit
            between two 18px targets. The gap in the stylesheet is the
            separator now. */}
        <nav class="shop-footer__legal" aria-label={lang === "de" ? "Rechtliches" : "Legal"}>
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          {/* Not a legal PAGE, but it belongs in this row: Art. 7 Abs. 3 DSGVO
              wants withdrawing a consent to be as easy as giving it, and a
              banner that shows once leaves no way back without this. */}
          <ConsentLink client:idle lang={lang} />
        </nav>
      </div>
    </footer>

    {/*
      No `categories` — this shop sets nothing beyond what it cannot work
      without: the theme, the language, the basket and the consent record
      itself, all covered by § 25 Abs. 2 Nr. 2 TDDDG. So the banner STATES
      that rather than asking a question with no content. Add a category here
      the day something optional actually ships, and the same component turns
      into a real gate.

      `privacyUrl` points at THIS site's policy. It used to fall back to the
      marketing domain, which sent a shop visitor to a document that does not
      describe the shop's own processing.
    */}
    <ConsentBanner
      client:idle
      lang={lang}
      privacyUrl={`${legalBase}/datenschutz`}
      imprintUrl={`${legalBase}/impressum`}
    />
  </body>
</html>
