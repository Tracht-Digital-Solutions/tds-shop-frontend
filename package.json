{
  "name": "tds-shop-frontend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:primitives": "node scripts/lint-primitives.mjs src",
    "type-check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "postbuild": "node node_modules/@tracht-digital-solutions/tds-shared/scripts/pack-release.mjs",
    "start": "node app.cjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tracht-digital-solutions/tds-shared": "^0.37.3",
    "astro": "^7.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.56.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "tds": {
    "notes": {
      "release": "What pack-release.mjs assembles for the production host. runtimeDependencies must stay PUBLIC-REGISTRY ONLY: the host has no GitHub Packages token, and everything first-party is bundled into server/ by vite.ssr.noExternal instead.",
      "noOgRenderer": "Unlike the journal, this site ships no Satori/Resvg OG renderer yet. A product card drawn from an Amazon image would breach the PA-API licence (their images may not be rehosted or edited), and a card for an own product is not worth two native dependencies on its own. Product pages use the product image as og:image and fall back to the static brand card."
    },
    "release": {
      "name": "tds-shop-release",
      "runtimeDependencies": {
        "@astrojs/node": "^11.1.4",
        "astro": "^7.1.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.34.0"
      }
    }
  }
}
